---
import BaseLayout from '../layouts/BaseLayout.astro'
import { sanity } from '../lib/sanity.js'

let projects = []
let editorials = []
let objects = []
let connectionOk = false

try {
  const [projectData, editorialData, objectData] = await Promise.all([
    sanity.fetch(`*[_type == "project" && published == true] | order(projectDate desc)[0...6]{
      _id, title, slug, category, summary, "cover": coverImage
    }`),
    sanity.fetch(`*[_type == "editorial" && published == true] | order(publishedAt desc)[0...3]{
      _id, title, slug, format, excerpt, publishedAt
    }`),
    sanity.fetch(`*[_type == "objectItem" && published == true] | order(publishedAt desc)[0...4]{
      _id, title, slug, category, itemType, shortDescription
    }`),
  ])
  projects = projectData || []
  editorials = editorialData || []
  objects = objectData || []
  connectionOk = true
} catch {
  connectionOk = false
}
---

<BaseLayout title="MR TIKINI" currentPath="/">
  <!-- Hero -->
  <section class="hero section">
    <div class="container">
      <p class="section-label">Portfolio</p>
      <h1>Creative direction,<br />music and culture.</h1>
      <p class="hero-lead text-muted">
        MR TIKINI — DJ, creative director and cultural platform based in Tokyo.
      </p>
    </div>
  </section>

  <!-- Selected Work -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <p class="section-label">Selected Work</p>
        <a href="/projects" class="section-link">View all</a>
      </div>

      {projects.length > 0 ? (
        <div class="card-grid">
          {projects.map((project) => (
            <a href={`/projects/${project.slug?.current || project._id}`} class="card">
              <div class="card-media"></div>
              <div class="card-body">
                <span class="card-meta">{project.category || 'Project'}</span>
                <h3>{project.title}</h3>
                {project.summary && <p class="text-muted">{project.summary}</p>}
              </div>
            </a>
          ))}
        </div>
      ) : (
        <p class="empty text-subtle">
          {connectionOk ? 'No published projects yet.' : 'Connect Sanity to load selected work.'}
        </p>
      )}
    </div>
  </section>

  <!-- Latest -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <p class="section-label">Latest</p>
        <a href="/latest" class="section-link">View all</a>
      </div>

      {editorials.length > 0 ? (
        <div class="list">
          {editorials.map((item) => (
            <a href={`/latest/${item.slug?.current || item._id}`} class="list-item">
              <div>
                <span class="card-meta">{item.format}</span>
                <h3>{item.title}</h3>
                {item.excerpt && <p class="text-muted">{item.excerpt}</p>}
              </div>
            </a>
          ))}
        </div>
      ) : (
        <p class="empty text-subtle">
          {connectionOk ? 'No editorial posts yet.' : 'Connect Sanity to load latest writing.'}
        </p>
      )}
    </div>
  </section>

  <!-- Objects -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <p class="section-label">Objects</p>
        <a href="/objects" class="section-link">View all</a>
      </div>

      {objects.length > 0 ? (
        <div class="card-grid card-grid--4">
          {objects.map((item) => (
            <a href={`/objects/${item.slug?.current || item._id}`} class="card card--compact">
              <div class="card-body">
                <span class="card-meta">{item.category}</span>
                <h3>{item.title}</h3>
                {item.shortDescription && (
                  <p class="text-muted">{item.shortDescription}</p>
                )}
              </div>
            </a>
          ))}
        </div>
      ) : (
        <p class="empty text-subtle">
          {connectionOk ? 'No objects published yet.' : 'Connect Sanity to load recommendations.'}
        </p>
      )}
    </div>
  </section>

  <!-- Contact teaser -->
  <section class="section">
    <div class="container">
      <p class="section-label">Contact</p>
      <h2>Bookings & collaborations</h2>
      <p class="text-muted contact-lead">
        For DJ bookings, creative direction and brand collaborations.
      </p>
      <a href="/contact" class="text-link">Get in touch →</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-top: var(--space-2xl);
    padding-bottom: var(--space-xl);
  }

  .hero-lead {
    margin-top: var(--space-md);
    max-width: 36ch;
    font-size: 1.05rem;
  }

  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
  }

  .section-header .section-label {
    margin-bottom: 0;
  }

  .section-link {
    font-size: 0.8rem;
    color: var(--color-muted);
  }

  .section-link:hover {
    color: var(--color-accent);
  }

  .card-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }

  @media (min-width: 700px) {
    .card-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .card-grid--4 {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .card {
    display: block;
  }

  .card-media {
    aspect-ratio: 4 / 3;
    background: #f4f4f4;
    margin-bottom: var(--space-sm);
  }

  .card-meta {
    display: block;
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-subtle);
    margin-bottom: 0.35rem;
  }

  .card h3 {
    font-size: 1.05rem;
    margin-bottom: 0.35rem;
  }

  .card p {
    font-size: 0.875rem;
    line-height: 1.45;
  }

  .card--compact .card-media {
    display: none;
  }

  .list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .list-item {
    display: block;
    padding: var(--space-md) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .list-item:first-child {
    border-top: 1px solid var(--color-border);
  }

  .list-item h3 {
    font-size: 1.1rem;
    margin-bottom: 0.25rem;
  }

  .list-item p {
    font-size: 0.875rem;
  }

  .empty {
    font-size: 0.9rem;
  }

  .contact-lead {
    margin: var(--space-sm) 0 var(--space-md);
    max-width: 32ch;
  }

  .text-link {
    font-size: 0.9rem;
    color: var(--color-fg);
    border-bottom: 1px solid var(--color-fg);
    padding-bottom: 1px;
  }

  .text-link:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }
</style>
